#!/usr/bin/env bash
# Robotermodell (igus ReBeL + Schunk EGP 40/25) aus iRC-Daten erzeugen.
# Die Daten stammen aus einer iRC-Installation (tools/irc_daten_export.ps1 auf einem Windows-PC)
# und werden nicht weitergegeben; sie bleiben nur in diesem Container.
#
#   rebel-sim-modell /root/irc-daten.zip
# Einfacher ohne Kopieren: im Browser im Einrichtungsassistenten hochladen (https://<container>/einrichtung).
set -euo pipefail
BASIS="${BASIS:-/opt/rebel-sim}"
ZIEL=/var/lib/rebel-sim/irc
ZIP="${1:?Aufruf: rebel-sim-modell <irc-daten.zip>}"
[ -f "$ZIP" ] || { echo "Datei nicht gefunden: $ZIP"; exit 1; }

rm -rf "$ZIEL.neu"
# wie beim Hochladen im Einrichtungsassistenten: nimmt nur Roboter und Schunk-Greifer, Pfade mit Backslash sind ok
python3 "$BASIS/tools/einrichtung.py" entpacken "$ZIP" "$ZIEL.neu" || { rm -rf "$ZIEL.neu"; exit 1; }
rm -rf "$ZIEL"
mv "$ZIEL.neu" "$ZIEL"
chown -R rebelsim:rebelsim "$ZIEL"
sudo -u rebelsim python3 "$BASIS/tools/erzeuge_rebel_modell.py" --irc "$ZIEL" --robot REBEL-6DOF-03
echo
echo "Modell erzeugt. Laufende Simulationen zeigen es nach 'Neu starten'."
