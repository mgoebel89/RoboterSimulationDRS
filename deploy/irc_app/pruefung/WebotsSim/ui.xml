<?xml version="1.0" encoding="UTF-8"?>
<!-- Bedienfeld der App WebotsSim (PRUEFVERSION 1.1.0, Stufe 0 der SPS-Kopplung).
     Die Struktur ist fest (iRC kann keine Zeilen nachtraeglich anlegen): je Richtung 8 Zeilen, unbenutzte blendet
     der Dienst im Container aus. Der Text "umlaut_test" prueft, ob iRC Umlaute und Pfeile richtig zeigt. -->
<ui>
	<ribbon label="Webots und SPS">
		<group label="SPS-Kopplung">
			<button name="band_lesen" label="Variablen lesen" />
			<toggle name="band_verbinden" label="Verbinden" />
		</group>
		<group label="Test">
			<button name="band_alles_aus" label="Alles auf 0" />
		</group>
	</ribbon>
	<main>
		<group name="g_verbindung" label="SPS-Kopplung">
			<text name="sps_status" value="Dienst der ReBeL-Simulation nicht verbunden" />
			<textbox name="sps_adresse" label="SPS-Adresse" value="" />
			<horizontal>
				<button name="sps_lesen" label="Variablen lesen" />
				<button name="sps_verbinden" label="Verbinden" />
				<button name="sps_trennen" label="Trennen" />
			</horizontal>
			<checkbox name="sps_alle_zeilen" label="Alle 8 Zeilen zeigen" />
			<text name="umlaut_test" value="Umlaut-Test: Prüfung äöü ÄÖÜ ß, Pfeil →" />
		</group>
		<group name="g_ein" label="SPS -> Roboter (iRC fragt GSig ab)">
			<horizontal>
				<combobox name="ein_1_var" label="Variable 1" value="- frei -"><item>- frei -</item></combobox>
				<numberbox name="ein_1_gsig" label="GSig" value="1" min="1" max="100" />
				<text name="ein_1_zustand" value="o" />
			</horizontal>
			<horizontal>
				<combobox name="ein_2_var" label="Variable 2" value="- frei -"><item>- frei -</item></combobox>
				<numberbox name="ein_2_gsig" label="GSig" value="2" min="1" max="100" />
