# Startseite fuer die Klasse: http://<container> (Port 80; der fruehere Port 8080 leitet dorthin um).
# Lehrerbereich verschluesselt auf https://<container> (Port 443), Zertifikat von rebel-sim-tls.
[Unit]
Description=ReBeL-Simulation Uebersichtsseite
After=network-online.target
Wants=network-online.target

[Service]
User=rebelsim
Group=rebelsim
Environment=UEBERSICHT_PORT=80
Environment=UMLEITEN_VON=8080
# Port 80 ohne root. Keine CapabilityBoundingSet-Zeile: der Dienst braucht sudo fuer rebel-sim-platz.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Zertifikat vor jedem Start pruefen bzw. erneuern; "+" = als root (root-eigene Kopie, siehe install.sh),
# "-" = schlaegt es fehl, startet die Seite trotzdem (dann ohne HTTPS)
ExecStartPre=-+/usr/local/sbin/rebel-sim-tls
ExecStart=/usr/bin/python3 /opt/rebel-sim/tools/uebersicht.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
